{
  "name": "md-link-checker",
  "version": "1.0.0",
  "description": "Fast CLI to check and validate markdown links in documentation",
  "main": "src/index.js",
  "bin": {
    "md-link-checker": "./bin/cli.js"
  },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "test:run": "node tests/index.test.js",
    "lint": "echo 'linting skipped'",
