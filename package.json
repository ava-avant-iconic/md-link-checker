    "commander": "^14.0.3",
    "csv-writer": "^1.6.0",
    "glob": "^13.0.5",
    "ignore-walk": "^8.0.0",
    "p-progress": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
